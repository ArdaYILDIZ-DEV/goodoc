# === goodoc — optimal .gitignore ===
# Goal: keep source, templates and content/ clean; exclude generated / cache / OS / IDE artifacts

# --- Build output (generated by build.py) ---
# build/ contains all HTML output — never commit, regenerate with `python build.py`
/build/
# Root index.html is also generated by build.py (redirects to build/). 
# Currently TRACKED for convenience (GitHub Pages root).
# Uncomment next line to ignore it and always regenerate (recommended if you deploy from build/):
# /index.html

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# Type checkers / linters / test caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- OS / filesystem ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
.Trashes
.Spotlight-V100
directory
*~

# --- Editors / IDE ---
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath
*.code-workspace
.history/

# --- Logs / temp / backup ---
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
.temp/
tmp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Misc ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Keep _attachments structure but ignore OS cruft inside ---
# .keep files are intentional to preserve empty _attachments/ folders — DO NOT ignore
!.keep
